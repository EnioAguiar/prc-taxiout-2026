# Copie para .env e preencha com o que o PRC enviar após a aprovação.
BUCKET_ACCESS_KEY=
BUCKET_ACCESS_SECRET=
# Nome da equipe (ex.: gentle-tractor). Usado no nome do arquivo e no bucket de envio.
TEAM_NAME=
# Opcional: sobrescreve o bucket de envio se não for igual ao TEAM_NAME.
SUBMISSION_BUCKET=
S3_ENDPOINT=s3.opensky-network.org
